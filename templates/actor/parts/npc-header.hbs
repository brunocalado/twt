{{!-- The printed masthead: name, type pill, tagline, the three badges, the rating strip. --}}
<div class="twt-npc-top">
  <header class="twt-npc-header">
    <img class="twt-npc-img" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img">

    <div class="twt-npc-identity">
      <input class="twt-npc-name" type="text" name="name" value="{{actor.name}}"
             placeholder="{{localize 'TWT.NPC.NamePlaceholder'}}" {{disabled (not editable)}}>
      <input class="twt-npc-tagline" type="text" name="system.tagline" value="{{system.tagline}}"
             placeholder="{{localize 'TWT.NPC.FIELDS.tagline.hint'}}" {{disabled (not editable)}}>
    </div>

    <select class="twt-type-pill" name="system.creatureType" {{disabled (not editable)}}
            aria-label="{{localize 'TWT.NPC.FIELDS.creatureType.label'}}">
      {{selectOptions creatureTypeChoices selected=system.creatureType localize=true}}
    </select>
  </header>

  <dl class="twt-npc-badges">
    <div class="twt-npc-badge">
      <dt>{{localize "TWT.Sheet.Armor"}}</dt>
      <dd>{{system.armor.current}}<span class="twt-health-sep">/</span>{{system.armor.base}}</dd>
    </div>

    {{!-- An absolute value, never "+2M": this is the difficulty of acting against this
          creature, and a plus sign would read as a modifier and mislead the table. --}}
    <div class="twt-npc-badge">
      <dt>{{localize "TWT.NPC.TargetDifficulty"}}</dt>
      <dd>{{system.targetDifficulty}}M</dd>
    </div>

    <div class="twt-npc-badge is-clickable">
      <dt>{{localize "TWT.Card.Health"}}</dt>
      <dd>
        <button type="button" data-action="openDamage" {{disabled (not editable)}}
                data-tooltip="{{localize 'TWT.NPC.ApplyDamage'}}">
          {{system.hp.value}}<span class="twt-health-sep">/</span>{{system.hp.max}}
        </button>
      </dd>
    </div>
  </dl>

  <div class="twt-npc-ratings">
    <label class="twt-rating">
      <span class="twt-rating-label">{{localize "TWT.NPC.FIELDS.threat.label"}}</span>
      <select name="system.threat" {{disabled (not editable)}}>
        {{selectOptions threatChoices selected=system.threat localize=true}}
      </select>
    </label>

    <label class="twt-rating">
      <span class="twt-rating-label">{{localize "TWT.NPC.FIELDS.size.label"}}</span>
      <input type="number" name="system.size" value="{{system.size}}" min="0.5" step="0.5"
             {{disabled (not editable)}}>
    </label>

    <label class="twt-rating">
      <span class="twt-rating-label">{{localize "TWT.Sheet.Speed"}}</span>
      <select name="system.speed" {{disabled (not editable)}}>
        {{selectOptions config.speeds selected=system.speed localize=true}}
      </select>
    </label>

    <label class="twt-rating">
      <span class="twt-rating-label">{{localize "TWT.NPC.FIELDS.hp.max.label"}}</span>
      <input type="number" name="system.hp.max" value="{{system.hp.max}}" min="1" step="1"
             {{disabled (not editable)}}>
    </label>

    <label class="twt-rating">
      <span class="twt-rating-label">{{localize "TWT.NPC.FIELDS.armor.base.label"}}</span>
      <input type="number" name="system.armor.base" value="{{system.armor.base}}" min="0" step="1"
             {{disabled (not editable)}}>
    </label>

    <label class="twt-rating">
      <span class="twt-rating-label">{{localize "TWT.Actor.FIELDS.targetDifficulty.label"}}</span>
      <input type="number" name="system.targetDifficulty" value="{{system.targetDifficulty}}"
             min="1" step="1" {{disabled (not editable)}}>
    </label>
  </div>
</div>
