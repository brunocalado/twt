{{!-- Deal damage, with the arithmetic shown before anything is written. --}}
<div class="twt-dialog-body">

  <div class="twt-field-row">
    <div class="twt-field">
      <span class="twt-field-label">{{localize "TWT.Damage.Amount"}}</span>
      <div class="twt-stepper">
        <button type="button" data-action="step" data-by="-1"
                aria-label="{{localize 'TWT.Damage.Less'}}">&minus;</button>
        <input type="number" name="amount" value="{{params.amount}}" min="0" step="1">
        <button type="button" data-action="step" data-by="1"
                aria-label="{{localize 'TWT.Damage.More'}}">+</button>
      </div>
    </div>

    <label class="twt-field">
      <span class="twt-field-label">{{localize "TWT.Damage.Type"}}</span>
      <select name="type">
        {{#each types}}
        <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
        {{/each}}
      </select>
    </label>
  </div>

  <label class="twt-check">
    <input type="checkbox" name="piercing" {{checked params.piercing}}>
    <span>{{localize "TWT.Damage.Piercing"}}
      <em class="twt-check-note">{{localize "TWT.Damage.PiercingHint"}}</em>
    </span>
  </label>

  <label class="twt-field">
    <span class="twt-field-label">{{localize "TWT.Damage.Source"}}</span>
    <input type="text" name="source" value="{{params.source}}"
           placeholder="{{localize 'TWT.Damage.SourcePlaceholder'}}">
  </label>

  <ul class="twt-damage-preview">
    {{#each rows}}
    <li class="twt-damage-row{{#if this.preview.kills}} is-lethal{{/if}}">
      <img class="twt-damage-img" src="{{this.actor.img}}" alt="">
      <div class="twt-damage-lines">
        <strong>{{this.actor.name}}</strong>
        <span>
          {{this.preview.incoming}} {{this.poolLabel}}{{#if this.preview.vulnerable}},
          {{localize "TWT.Damage.VulnerablePlus"}} = {{this.preview.amount}}{{/if}}.
          {{#if this.preview.absorbed}}{{localize "TWT.Damage.ArmorAbsorbs"}}
          {{this.preview.absorbed}}.{{/if}}
          {{this.preview.applied}} {{localize "TWT.Damage.ToPool"}}:
          {{this.preview.before}} &rarr; {{this.preview.after}}.
          {{#if this.preview.overkill}}{{localize "TWT.Damage.Overkill"}}
          {{this.preview.overkill}}.{{/if}}
        </span>
        {{#if this.preview.kills}}
        <em class="twt-damage-lethal">{{localize "TWT.Damage.Lethal"}}</em>
        {{/if}}
      </div>
    </li>
    {{/each}}
  </ul>

  <footer class="twt-dialog-footer">
    <button type="submit" class="twt-primary">
      <i class="fa-solid fa-droplet" inert></i>
      {{localize "TWT.Damage.Apply"}}
    </button>
  </footer>
</div>
