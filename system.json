{
  "id": "twt",
  "title": "Time Without Tide",
  "description": "A Victorian apocalypse TTRPG where the moon shattered and eldritch fog consumes the world. Unofficial fan-made system. Time Without Tide is copyright Chaosium Studios LLC; this system is not published, endorsed, or approved by Chaosium Inc.",
  "version": "0.0.2",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [],
  "esmodules": [
    "module/twt.mjs"
  ],
  "styles": [
    "css/twt.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "socket": true,
  "initiative": "1d6",
  "grid": {
    "type": 0,
    "distance": 1,
    "units": "zone"
  },
  "documentTypes": {
    "Actor": {
      "delver": {
        "htmlFields": [
          "biography",
          "notes"
        ]
      },
      "npc": {
        "htmlFields": [
          "biography",
          "notes",
          "tactics"
        ]
      }
    },
    "Item": {
      "equipment": {
        "htmlFields": [
          "description",
          "rules"
        ]
      },
      "feature": {
        "htmlFields": [
          "description",
          "rules"
        ]
      },
      "adaptation": {
        "htmlFields": [
          "description",
          "rules"
        ]
      }
    },
    "RegionBehavior": {
      "zone": {}
    }
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "css",
        "templates",
        "lang"
      ]
    }
  },
  "license": "LICENSE",
  "url": "https://github.com/brunocalado/twt",
  "manifest": "https://github.com/brunocalado/twt/releases/latest/download/system.json",
  "download": "https://github.com/brunocalado/twt/releases/download/v0.0.1/twt.zip",
